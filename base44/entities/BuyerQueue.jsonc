{
  "name": "BuyerQueue",
  "type": "object",
  "properties": {
    "buyer_id": {
      "type": "string",
      "description": "ID du buyer dans la file"
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "served"
      ],
      "default": "waiting",
      "description": "Statut dans la file"
    },
    "joined_at": {
      "type": "string",
      "format": "date-time",
      "description": "Moment d'entr\u00e9e dans la file"
    },
    "served_at": {
      "type": "string",
      "format": "date-time",
      "description": "Moment o\u00f9 la soumission a \u00e9t\u00e9 claim"
    },
    "claimed_submission_id": {
      "type": "string",
      "description": "ID de la soumission claim\u00e9e par ce buyer"
    }
  },
  "required": [
    "buyer_id"
  ]
}