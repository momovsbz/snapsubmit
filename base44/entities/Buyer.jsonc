{
  "name": "Buyer",
  "type": "object",
  "properties": {
    "username": {
      "type": "string",
      "description": "Nom d'utilisateur de l'acheteur"
    },
    "password_hash": {
      "type": "string",
      "description": "Hash SHA-256 du mot de passe"
    },
    "queue_order": {
      "type": "integer",
      "default": 0,
      "description": "Position dans la file tournante (round-robin)"
    },
    "active": {
      "type": "boolean",
      "default": true,
      "description": "Acheteur actif dans la rotation"
    },
    "claimed_count": {
      "type": "integer",
      "default": 0,
      "description": "Nombre total de soumissions r\u00e9clam\u00e9es"
    }
  },
  "required": [
    "username",
    "password_hash"
  ]
}