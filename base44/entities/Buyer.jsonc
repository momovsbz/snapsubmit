{
  "name": "Buyer",
  "type": "object",
  "properties": {
    "discord": {
      "type": "string",
      "description": "Pseudo Discord du buyer"
    },
    "password": {
      "type": "string",
      "description": "Mot de passe hash\u00e9 (SHA-256)"
    },
    "bound_ip": {
      "type": "string",
      "description": "Adresse IP li\u00e9e au compte (premi\u00e8re connexion)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Compte actif"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Date d'expiration de l'acc\u00e8s (dur\u00e9e d'abonnement)"
    }
  },
  "required": [
    "discord",
    "password"
  ]
}